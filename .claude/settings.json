{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git credential *)",
      "Bash(git config *)",
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(git pull:*)",
      "Bash(grep:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Skill(accept-many)",
      "Skill(accept-one)",
      "Skill(search-to-sheet)",
      "mcp__claude-in-chrome__javascript_tool"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --porcelain 2>/dev/null | grep -q . && printf '{\"systemMessage\":\"You have uncommitted changes — consider committing before closing.\"}' || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session-start.py\"",
            "timeout": 25,
            "statusMessage": "Checking GitHub and your METIS worklist..."
          }
        ]
      }
    ]
  }
}
